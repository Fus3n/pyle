struct array {
    fn append(val): none { }
    fn size(): int { }
    fn pop(): any { }
    fn reverse(): none { }
    fn slice(start: int, end: int): array { }
    fn clear(): none { }
    fn reserve(capacity: int): none { }
    fn resize(new_size: int, default_value): none { }
    fn map(callback: function): array { }
    fn filter(callback: function): array { }
    fn find(callback: function): any { }
    fn index_of(value: any): int? { }
}
