struct string {
    fn size(): int { }
    fn to_num(): int | float | none { }
    fn slice(start: int, end: int): string { }
    fn is_digit(): bool { }
    fn is_alpha(): bool { }
    fn is_alnum(): bool { }
    fn is_space(): bool { }
    fn join(arr: array): string { }
    fn lower(): string { }
    fn upper(): string { }
    fn split(delimiter: string): array { }
    fn to_bytes(): bytes { }
    fn trim(): string { }
    fn contains(sub: string): bool { }
    fn starts_with(prefix: string): bool { }
    fn ends_with(suffix: string): bool { }
    fn replace(old: string, new: string): string { }
}
