# cfg.pyl - configuration and tunables for the Fruit Merge game.

let rl = import("raylib")

struct Cfg(gravity, restitution, friction, air_damp, ang_damp, substeps,
           iterations, left, right, bottom, wall, danger, spawn_y, merge_cd,
           merge_touch, drop_cooldown, game_over_hold, combo_window, bonus,
           settle_speed, tier_r, tier_score, tier_col) {
    static fn make() {
        let tier_r = [18, 24, 30, 38, 46, 55, 64, 74, 85, 98, 112]
        let tier_score = [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 66]
        let tier_col = [
            rl.Color(225, 35, 55, 255),
            rl.Color(255, 120, 170, 255),
            rl.Color(150, 70, 210, 255),
            rl.Color(70, 110, 225, 255),
            rl.Color(40, 185, 205, 255),
            rl.Color(60, 195, 85, 255),
            rl.Color(165, 215, 55, 255),
            rl.Color(250, 220, 60, 255),
            rl.Color(255, 150, 45, 255),
            rl.Color(240, 95, 35, 255),
            rl.Color(30, 150, 70, 255)
        ]
        return Cfg(
            gravity: 1500.0,
            restitution: 0.25,
            friction: 0.7,
            air_damp: 0.999,
            ang_damp: 0.999,
            substeps: 8,
            iterations: 8,
            left: 110,
            right: 610,
            bottom: 900,
            wall: 10,
            danger: 150,
            spawn_y: 70,
            merge_cd: 0.15,
            merge_touch: 6.0,
            drop_cooldown: 0.4,
            game_over_hold: 2.0,
            combo_window: 1.0,
            bonus: 100,
            settle_speed: 40.0,
            tier_r: tier_r,
            tier_score: tier_score,
            tier_col: tier_col
        )
    }
}
