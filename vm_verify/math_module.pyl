# Core `math` module (built-in libpyle). Exercises constants + functions.
let m = import("math")

print(format("PI={}", m.PI))
print(format("TAU={}", m.TAU))
print(format("E={}", m.E))
print(format("floor(3.7)={} (expect 3)", m.floor(3.7)))
print(format("ceil(3.2)={} (expect 4)", m.ceil(3.2)))
print(format("round(2.5)={} (expect 3)", m.round(2.5)))
print(format("trunc(-2.9)={} (expect -2)", m.trunc(-2.9)))
print(format("abs(-5)={} (expect 5)", m.abs(-5)))
print(format("abs(-5.5)={} (expect 5.5)", m.abs(-5.5)))
print(format("sign(-3)={} (expect -1)", m.sign(-3)))
print(format("sqrt(16)={} (expect 4)", m.sqrt(16)))
print(format("pow(2,10)={} (expect 1024)", m.pow(2, 10)))
print(format("min(3,7)={} (expect 3)", m.min(3, 7)))
print(format("min(3.5,7)={} (expect 3.5)", m.min(3.5, 7)))
print(format("max(3,7)={} (expect 7)", m.max(3, 7)))
print(format("clamp(15,0,10)={} (expect 10)", m.clamp(15, 0, 10)))
print(format("sin(0)={} (expect 0)", m.sin(0)))
print(format("cos(0)={} (expect 1)", m.cos(0)))
print(format("atan2(1,0)={} (expect 1.57)", m.atan2(1, 0)))
print(format("hypot(3,4)={} (expect 5)", m.hypot(3, 4)))
print(format("radians(180)={} (expect 3.14)", m.radians(180)))
print(format("degrees(3.14159)={} (expect 180)", m.degrees(3.14159)))
print("DONE")
